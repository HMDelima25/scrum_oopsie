PORT=5000
HOST=127.0.0.1
NODE_ENV=development
SUPABASE_URL=https://tlsqkmjrmcnlgucjniuv.supabase.co
SUPABASE_SECRET_KEY=server-only-key-from-supabase-dashboard
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_URL=http://localhost:5000
FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:4173,http://127.0.0.1:4173
# local writes setup invitations to ignored var/outbox; recovery codes require SMTP.
MAIL_DELIVERY=local
GOOGLE_OAUTH_ENABLED=false
# Google OAuth credentials are also configured in Supabase Authentication > Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# To send real account emails, set MAIL_DELIVERY=smtp and these values:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
